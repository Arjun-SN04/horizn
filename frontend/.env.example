# Copy this file to .env (local dev) and/or .env.production (production build)
# and fill in real values. Neither .env nor .env.production is tracked by git —
# only this template is.

# VITE_API_URL=https://your-backend-host.example.com

# Street View (ShowListing page). Get a free "Client Token" by registering an app at
# https://www.mapillary.com/dashboard/developers — it's a public/client-side token, safe to
# ship in the frontend bundle (same model as a Mapbox public token). Without it, the Street
# View button simply never appears — no error, no broken UI.
# VITE_MAPILLARY_ACCESS_TOKEN=your-mapillary-client-token
